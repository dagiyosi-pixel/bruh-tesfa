# =============================================================================
# BRUH TESFA (ብሩህ ተስፋ) - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or real credentials to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PERSISTENCE & DATABASE STORAGE
# -----------------------------------------------------------------------------
# PERSISTENCE_MODE controls how Bruh Tesfa persists records:
#   - 'local'   : Strictly uses local atomic JSON storage (data/bruh-tesfa-db.json).
#                 Recommended for local development, tests, and offline demos.
#   - 'supabase': Enforces cloud Supabase PostgreSQL & Storage. Fails fast if credentials missing.
#   - unset     : Auto-detects (uses Supabase if credentials are present, else local for dev).
# Note: In production (NODE_ENV=production), Supabase credentials are required unless PERSISTENCE_MODE=local.
PERSISTENCE_MODE=local

# Supabase Cloud Project Configuration (Required for shared production deployments)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# The service role key is strictly used on the server for admin operations & signed storage URLs.
# Never expose this key in client-side bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# 2. ADMINISTRATOR SECURITY & SESSIONS
# -----------------------------------------------------------------------------
# Initial administrator password required at /admin/login
ADMIN_INITIAL_PASSWORD=BruhTesfaAdmin2026!

# Cryptographic secret used for HMAC-SHA256 session token signatures.
# In production, set this to a strong random 64-character secret.
ADMIN_JWT_SECRET=bruh-tesfa-secure-production-secret-addis-2026

# -----------------------------------------------------------------------------
# 3. BRAND, APP & COMMUNITY CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/bruhtesfa_community
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/bruhtesfa_announcements
NEXT_PUBLIC_SUPPORT_PHONE=+251 91 123 4567
NEXT_PUBLIC_SUPPORT_EMAIL=contact@bruhtesfa.com

# -----------------------------------------------------------------------------
# 4. TELEGRAM BOT API, WEBHOOK & CHANNEL INTEGRATION
# -----------------------------------------------------------------------------
# Bruh Tesfa supports interactive Telegram bot commands, opt-in vacancy alerts,
# and direct channel publishing via official HTTPS webhooks.
#
# 1. Obtain a Bot Token from @BotFather on Telegram (/newbot)
# 2. Add your Bot as an Administrator to your channel with "Post Messages" permission
# 3. Set a random 32+ character secret for webhook signature verification
# 4. Register the webhook via: node scripts/setup-telegram-webhook.mjs set <https://your-domain>
#
# IMPORTANT: Never prefix TELEGRAM_BOT_TOKEN or TELEGRAM_WEBHOOK_SECRET with NEXT_PUBLIC_
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=bruh_tesfa_secure_webhook_secret_addis_2026
TELEGRAM_CHANNEL_ID=@bruhtesfa_announcements
TELEGRAM_CHANNEL_USERNAME=bruhtesfa_announcements
